<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 JIT under Hardened Runtime needs MAP_JIT; the only entitlement the
       bundled node runtime gets. No sandbox/parent/network exceptions. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
