# Pinned bundled runtimes for the macOS app bundle (scripts/bundle-macos.sh):
# every bundled third-party binary is pinned by version AND SHA-256 here.
# Sourced, not executed. Changing a pin requires updating the SHA-256 from the
# vendor's published checksums AND docs/macos-bundle.md.
#
# Node.js official distribution, macOS arm64. SHA-256 cross-checked against
# https://nodejs.org/dist/v<version>/SHASUMS256.txt (GPG-signed by a Node
# release key) at pin time. Keep the pin on the newest security release of
# its line: release-check.sh fails when nodejs.org lists a newer one.
# 24.22.2 (LTS "Krypton") includes the 2026-10-20 security release 24.22.1.
NODE_RUNTIME_VERSION=24.22.2
NODE_RUNTIME_PLATFORM=darwin-arm64
NODE_RUNTIME_TARBALL=node-v24.22.2-darwin-arm64.tar.gz
NODE_RUNTIME_TARBALL_SHA256=aa9549349e47dffaa42dcf95d6e06ade8c4bdafc980979883b88767670df385a

# cloudflared (optional component for public links): official release asset
# of github.com/cloudflare/cloudflared, macOS arm64 — never a local Homebrew
# copy. Cloudflare's release notes ("SHA256 Checksums") list, under the
# .tgz asset name, the SHA-256 of the binary INSIDE the archive; that vendor
# value is CLOUDFLARED_BINARY_SHA256 and is verified after extraction. The
# archive itself is pinned as downloaded at pin time (its binary matched the
# vendor value), the license text comes from the same release tag.
# Re-pin on every cloudflared release with a security fix (RELEASE_NOTES).
CLOUDFLARED_VERSION=2026.10.7
CLOUDFLARED_TARBALL=cloudflared-darwin-arm64.tgz
CLOUDFLARED_TARBALL_SHA256=3586ccf397e98e5f437e60e7c307ca6ac463e110580503af8bb8e6f9ebf831bd
CLOUDFLARED_BINARY_SHA256=2136431d5eb467bf447d2ee514b713e192719b143aec1d9e09bf7dc290d5bb12
CLOUDFLARED_LICENSE_SHA256=58d1e17ffe5109a7ae296caafcadfdbe6a7d176f0bc4ab01e12a689b0499d8bd
